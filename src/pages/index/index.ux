<template>
  <div class="page">
    <!-- Игровой экран. Долгое нажатие: на букву — выбор буквы, на цифру — цвет цифр, на фон — цвет фона -->
    <div class="game" if="{{loaded && !finished && !picker}}">
      <div
        class="zone"
        style="background-color: {{settings.bg[0]}};"
        @touchstart="touchStart"
        @click="add(0)"
        @longpress="zonePress(0)"
      >
        <text class="label" style="color: {{settings.colors[0]}};" @longpress="labelPress(0)">{{settings.labels[0]}}</text>
        <text class="score" style="color: {{settings.colors[0]}};" @longpress="scorePress(0)">{{scores[0]}}</text>
      </div>

      <!-- Иконки картинками: в шрифте браслета нет символов вроде ↶ -->
      <div class="controls">
        <div class="btn" @click="undo">
          <image class="btn-icon" src="/common/undo.png"></image>
        </div>
        <!-- Сумма очков обоих игроков: в паделе по ней считают смену подачи и длину игры -->
        <text class="total">{{scores[0] + scores[1]}}</text>
        <div class="btn btn-finish" @click="finish">
          <image class="btn-icon" src="/common/stop.png"></image>
        </div>
      </div>

      <div
        class="zone"
        style="background-color: {{settings.bg[1]}};"
        @touchstart="touchStart"
        @click="add(1)"
        @longpress="zonePress(1)"
      >
        <text class="score" style="color: {{settings.colors[1]}};" @longpress="scorePress(1)">{{scores[1]}}</text>
        <text class="label" style="color: {{settings.colors[1]}};" @longpress="labelPress(1)">{{settings.labels[1]}}</text>
      </div>
    </div>

    <!-- Выбор буквы или цвета. Встроен в страницу, а не открывается отдельной:
         переход на новую страницу гасил экран примерно на секунду -->
    <scroll class="picker" scroll-y="true" if="{{picker}}" @touchstart="pickerTouch">
      <text class="picker-title">{{ $t('picker.' + picker.kind, { label: picker.label }) }}</text>
      <div class="grid-row" for="(r, row) in picker.rows">
        <div
          for="(i, cell) in row"
          class="cell"
          style="width: {{picker.cellWidth}}px; height: {{picker.cellHeight}}px; border-radius: {{picker.cellRadius}}px; background-color: {{cell.bg}}; border-color: {{cell.selected ? '#FBFBFB' : '#3A3A3A'}};"
          @click="choose(cell.value)"
        >
          <text style="font-size: {{picker.fontSize}}px; color: {{cell.fg}};">{{cell.text}}</text>
        </div>
      </div>
      <div class="spacer"></div>
    </scroll>

    <!-- Экран результата: кнопки и список игр, текущая — первой строкой, крупнее.
         Список — ровно то, что лежит в истории, поэтому очистка убирает всё, что видно -->
    <scroll class="result" scroll-y="true" if="{{finished && !detail}}">
      <div class="result-buttons">
        <div class="btn-round" @click="resume">
          <image class="btn-icon" src="/common/play.png"></image>
        </div>
        <div class="btn-round btn-new" @click="reset">
          <image class="btn-icon" src="/common/restart.png"></image>
        </div>
      </div>

      <!-- Строки — столбцы «A счёт : счёт B», симметричные относительно двоеточия.
           Текущая игра первой, отделена от прошлых полосой -->
      <div class="game-row" if="{{current}}" @click="openGame(current.id)">
        <div class="g-chip" style="background-color: {{current.sides[0].bg}}; border-color: {{current.sides[0].bg}}; opacity: {{current.sides[0].opacity}};">
          <text class="g-label" style="color: {{current.sides[0].fg}};">{{current.labels[0]}}</text>
        </div>
        <text class="g-score">{{current.scores[0]}}</text>
        <text class="g-colon">:</text>
        <text class="g-score">{{current.scores[1]}}</text>
        <div class="g-chip" style="background-color: {{current.sides[1].bg}}; border-color: {{current.sides[1].bg}}; opacity: {{current.sides[1].opacity}};">
          <text class="g-label" style="color: {{current.sides[1].fg}};">{{current.labels[1]}}</text>
        </div>
      </div>
      <div class="divider" if="{{current && games.length > 0}}"></div>

      <div class="game-row" for="(i, g) in games" @click="openGame(g.id)">
        <div class="g-chip" style="background-color: {{g.sides[0].bg}}; border-color: {{g.sides[0].bg}}; opacity: {{g.sides[0].opacity}};">
          <text class="g-label" style="color: {{g.sides[0].fg}};">{{g.labels[0]}}</text>
        </div>
        <text class="g-score">{{g.scores[0]}}</text>
        <text class="g-colon">:</text>
        <text class="g-score">{{g.scores[1]}}</text>
        <div class="g-chip" style="background-color: {{g.sides[1].bg}}; border-color: {{g.sides[1].bg}}; opacity: {{g.sides[1].opacity}};">
          <text class="g-label" style="color: {{g.sides[1].fg}};">{{g.labels[1]}}</text>
        </div>
      </div>

      <!-- Очистка по долгому нажатию, чтобы не стереть историю случайным тапом -->
      <div class="btn-round btn-clear" if="{{current || games.length > 0}}" @longpress="clearHistory">
        <image class="btn-icon" src="/common/trash.png"></image>
      </div>
      <div class="spacer"></div>
    </scroll>

    <!-- Окно игры из истории: плашки игроков, длительность и разбивка по очкам.
         Закрывается свайпом вправо (onBackPress) -->
    <scroll class="detail" scroll-y="true" if="{{detail}}">
      <div class="detail-head">
        <div class="detail-side" style="background-color: {{detail.sides[0].bg}}; border-color: {{detail.sides[0].bg}}; opacity: {{detail.sides[0].opacity}};">
          <text class="detail-label" style="color: {{detail.sides[0].fg}};">{{detail.labels[0]}}</text>
          <text class="detail-num" style="color: {{detail.sides[0].fg}};">{{detail.scores[0]}}</text>
        </div>
        <div class="detail-side" style="background-color: {{detail.sides[1].bg}}; border-color: {{detail.sides[1].bg}}; opacity: {{detail.sides[1].opacity}};">
          <text class="detail-label" style="color: {{detail.sides[1].fg}};">{{detail.labels[1]}}</text>
          <text class="detail-num" style="color: {{detail.sides[1].fg}};">{{detail.scores[1]}}</text>
        </div>
      </div>
      <text class="detail-interval">{{detail.interval}}</text>

      <!-- Счёт после каждого очка, последние сверху; число игрока, взявшего очко, — белое -->
      <div class="pt-row" for="(i, r) in detail.rows">
        <text class="pt-time">{{r.time}}</text>
        <text class="pt-score" style="color: {{r.hot === 0 ? '#FBFBFB' : '#5A5A5A'}};">{{r.a}}</text>
        <text class="pt-colon">:</text>
        <text class="pt-score" style="color: {{r.hot === 1 ? '#FBFBFB' : '#5A5A5A'}};">{{r.b}}</text>
      </div>

      <!-- Удаление игры по долгому нажатию, чтобы не стереть её случайным тапом -->
      <div class="btn-round btn-clear" @longpress="deleteGame(detail.id)">
        <image class="btn-icon" src="/common/trash.png"></image>
      </div>
      <div class="spacer"></div>
    </scroll>
  </div>
</template>

<script>
import vibrator from '@system.vibrator'
import { load, save, defaults } from '../../common/settings.js'
import { buildPicker, applyChoice } from '../../common/picker.js'
import { loadGames, withGame, saveGames, clearGames } from '../../common/games.js'

// Проигравшая сторона на экране итога и в истории приглушается прозрачностью:
// перекраска в серый не работает, когда цифры сами серые или чёрные на чёрном
const LOSER_OPACITY = 0.4
const BLACK = ['#000000', '#000000']

function pad(n) {
  return (n < 10 ? '0' : '') + n
}

// Секунды как m:ss, от часа — h:mm:ss
function formatClock(sec) {
  const h = Math.floor(sec / 3600)
  const m = Math.floor(sec / 60) % 60
  const ss = pad(sec % 60)
  return h > 0 ? `${h}:${pad(m)}:${ss}` : `${m}:${ss}`
}

// Время суток как на часах: 18:53
function formatTimeOfDay(ts) {
  const d = new Date(ts)
  return `${pad(d.getHours())}:${pad(d.getMinutes())}`
}

// Данные окна игры: интервал «старт - финиш» по часам и время каждого очка от начала игры.
// В играх из версий до 1.9.0 разбивки и времени финиша нет — только плашки и время старта
function buildDetail(game) {
  const running = [0, 0]
  const rows = (game.points || []).map(([zone, t]) => {
    running[zone] += 1
    return { time: formatClock(t), a: running[0], b: running[1], hot: zone }
  }).reverse() // последние очки сверху
  return Object.assign({}, game, {
    sides: sides(game.colors, game.bg, game.scores),
    interval: game.duration === undefined
      ? formatTimeOfDay(game.at)
      : `${formatTimeOfDay(game.at)} - ${formatTimeOfDay(game.at + game.duration * 1000)}`,
    rows
  })
}

// Как показать стороны: цифры на фоне игрока, как в игре. При ничьей обе яркие.
// В играх из версий до 1.3.5 фон не сохранялся — для них чёрный
function sides(colors, bg, scores) {
  const [a, b] = scores
  const lost = [a < b, b < a]
  return [0, 1].map(i => ({
    fg: colors[i],
    bg: (bg || BLACK)[i],
    opacity: lost[i] ? LOSER_OPACITY : 1
  }))
}

export default {
  private: {
    settings: defaults(),
    // Настройки читаются из хранилища асинхронно; до этого экран не рисуем,
    // иначе на долю секунды мелькают цвета по умолчанию
    loaded: false,
    scores: [0, 0],
    // Очки по порядку: { zone, t }, t — миллисекунды от начала игры. Для отмены и разбивки в истории
    history: [],
    startedAt: 0,
    finished: false,
    // Поля экрана результата, заполняются в finish()
    // Текущая игра для первой строки списка или null, если её нет в истории (0:0 или очищена)
    current: null,
    // Остальные игры из истории
    games: [],
    // Вся история в памяти: экран итога рисуется из неё сразу, а запись в хранилище идёт в фоне.
    // Иначе до конца асинхронной записи на экране оставался список от прошлого завершения
    allGames: [],
    // longpress всплывает от буквы и цифры к зоне, а способа остановить всплытие в Vela нет:
    // зона пропускает своё долгое нажатие, если только что сработало вложенное
    childPressAt: 0,
    // После долгого нажатия может прийти и click — его не надо засчитывать как очко
    suppressClick: false,
    // Открытый экран выбора (см. buildPicker) или null
    picker: null,
    // Открытое окно игры из истории (см. buildDetail) или null
    detail: null,
    // Выбор открывается, пока палец ещё на экране, и его отпускание не должно выбрать
    // плитку под ним — плитки срабатывают только после нового касания
    pickerArmed: false
  },

  onInit() {
    this.startedAt = Date.now()
    loadGames(list => {
      this.allGames = list
    })
  },

  onShow() {
    load(settings => {
      this.settings = settings
      this.loaded = true
    })
  },

  touchStart() {
    this.suppressClick = false
  },

  add(zone) {
    if (this.suppressClick) {
      this.suppressClick = false
      return
    }
    const scores = this.scores.slice()
    scores[zone] += 1
    this.scores = scores
    this.history.push({ zone, t: Date.now() - this.startedAt })
    vibrator.vibrate({ mode: 'short' })
  },

  undo() {
    if (this.history.length === 0) return
    const { zone } = this.history.pop()
    const scores = this.scores.slice()
    scores[zone] -= 1
    this.scores = scores
    vibrator.vibrate({ mode: 'short' })
  },

  // Свайп вправо на экране выбора или в окне игры закрывает их, а не всё приложение
  onBackPress() {
    if (this.picker) {
      this.picker = null
      return true
    }
    if (this.detail) {
      this.detail = null
      return true
    }
    return false
  },

  openPicker(kind, player) {
    this.suppressClick = true
    this.pickerArmed = false
    vibrator.vibrate({ mode: 'short' })
    this.picker = buildPicker(this.settings, kind, player)
  },

  pickerTouch() {
    this.pickerArmed = true
  },

  choose(value) {
    if (!this.pickerArmed) return
    this.settings = applyChoice(this.settings, this.picker, value)
    save(this.settings)
    this.picker = null
  },

  labelPress(player) {
    this.childPressAt = Date.now()
    this.openPicker('label', player)
  },

  scorePress(player) {
    this.childPressAt = Date.now()
    this.openPicker('color', player)
  },

  zonePress(player) {
    if (Date.now() - this.childPressAt < 500) return
    this.openPicker('bg', player)
  },

  finish() {
    const { colors, labels, bg } = this.settings
    const [a, b] = this.scores
    this.finished = true
    vibrator.vibrate({ mode: 'long' })

    const list = withGame(this.allGames, {
      id: this.startedAt,
      at: this.startedAt,
      labels: labels.slice(),
      colors: colors.slice(),
      bg: bg.slice(),
      scores: [a, b],
      // Компактно для хранилища: [зона, секунды от начала]
      points: this.history.map(p => [p.zone, Math.round(p.t / 1000)]),
      duration: Math.round((Date.now() - this.startedAt) / 1000)
    })
    this.showGames(list)
  },

  // Запоминает историю, сохраняет её в фоне и обновляет список на экране итога
  showGames(list) {
    this.allGames = list
    saveGames(list)
    const stored = list.find(g => g.id === this.startedAt)
    this.current = stored ? Object.assign({}, stored, { sides: sides(stored.colors, stored.bg, stored.scores) }) : null
    this.games = list
      .filter(g => g.id !== this.startedAt)
      .map(g => Object.assign({}, g, { sides: sides(g.colors, g.bg, g.scores) }))
  },

  openGame(id) {
    const game = this.allGames.find(g => g.id === id)
    if (game) this.detail = buildDetail(game)
  },

  deleteGame(id) {
    vibrator.vibrate({ mode: 'short' })
    this.detail = null
    this.showGames(this.allGames.filter(g => g.id !== id))
  },

  clearHistory() {
    vibrator.vibrate({ mode: 'short' })
    // Стирается и текущая игра: если её продолжить и завершить снова, она запишется заново
    this.allGames = []
    this.current = null
    this.games = []
    clearGames()
  },

  resume() {
    this.finished = false
  },

  reset() {
    this.scores = [0, 0]
    this.history = []
    this.startedAt = Date.now()
    this.finished = false
  }
}
</script>

<style>
.page {
  width: 212px;
  height: 520px;
  background-color: #000000;
}

.game {
  width: 212px;
  height: 520px;
  flex-direction: column;
}

.zone {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* Отступы увеличивают область долгого нажатия на маленькую букву */
/* Без прозрачности: на ярком фоне полупрозрачная буква сливалась с ним */
.label {
  font-size: 30px;
  font-weight: bold;
  padding: 6px 24px;
}

.score {
  font-size: 110px;
  font-weight: bold;
}

.controls {
  height: 72px;
  padding: 0 10px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  background-color: #000000;
}

.total {
  flex: 1;
  font-size: 26px;
  color: #989898;
  text-align: center;
}

/* border-radius работает только вместе с border-width и border-color */
/* Между кнопками остаётся ~40px — под двузначную сумму очков */
.btn {
  width: 76px;
  height: 52px;
  border-width: 2px;
  border-color: #3a3a3a;
  border-radius: 26px;
  justify-content: center;
  align-items: center;
}

.btn-finish {
  border-color: #fb8247;
}

.btn-icon {
  width: 32px;
  height: 32px;
}

.result {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
}

.result-buttons {
  width: 180px;
  flex-direction: row;
  justify-content: space-around;
  margin-top: 56px;
  margin-bottom: 24px;
}

/* border-radius работает только вместе с border-width и border-color */
.btn-round {
  width: 64px;
  height: 64px;
  border-width: 2px;
  border-color: #3a3a3a;
  border-radius: 32px;
  justify-content: center;
  align-items: center;
}

.btn-new {
  border-color: #fb8247;
}

.btn-clear {
  margin-top: 20px;
}

.divider {
  width: 180px;
  height: 2px;
  background-color: #3a3a3a;
  margin-top: 4px;
  margin-bottom: 4px;
}

.game-row {
  width: 180px;
  height: 46px;
  flex-direction: row;
  align-items: center;
}

.g-colon {
  width: 12px;
  font-size: 30px;
  color: #fbfbfb;
  text-align: center;
}

.g-chip {
  width: 36px;
  height: 36px;
  border-width: 1px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
}

.g-label {
  font-size: 24px;
  font-weight: bold;
}

/* Числа по центру одинаковых колонок: строки выглядят как столбцы, и плашки не прижимаются к цифрам */
.g-score {
  width: 48px;
  font-size: 30px;
  color: #fbfbfb;
  text-align: center;
}

.spacer {
  height: 60px;
}

.detail {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
}

.detail-head {
  width: 180px;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 48px;
}

/* border-radius работает только вместе с border-width и border-color (задаются цветом фона) */
.detail-side {
  width: 84px;
  padding: 4px 0;
  border-width: 2px;
  border-radius: 16px;
  flex-direction: column;
  align-items: center;
}

.detail-label {
  font-size: 28px;
  font-weight: bold;
}

.detail-num {
  font-size: 56px;
  font-weight: bold;
}

.detail-interval {
  font-size: 24px;
  color: #fbfbfb;
  margin-top: 12px;
  margin-bottom: 12px;
}

.pt-row {
  width: 180px;
  height: 34px;
  flex-direction: row;
  align-items: center;
}

.pt-time {
  width: 70px;
  font-size: 20px;
  color: #989898;
}

.pt-colon {
  width: 10px;
  font-size: 26px;
  color: #5a5a5a;
  text-align: center;
}

.pt-score {
  width: 50px;
  font-size: 26px;
  font-weight: bold;
  text-align: center;
}

.picker {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
}

.picker-title {
  font-size: 24px;
  color: #989898;
  margin-top: 40px;
  margin-bottom: 14px;
}

.grid-row {
  flex-direction: row;
  justify-content: center;
}

/* border-radius работает только вместе с border-width и border-color */
.cell {
  border-width: 2px;
  border-color: #3a3a3a;
  margin: 3px;
  justify-content: center;
  align-items: center;
}
</style>
